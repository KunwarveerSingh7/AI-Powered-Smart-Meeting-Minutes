"""Module to extract action items from meeting transcripts using Ollama.

Uses only the standard library to avoid external dependency on `requests`.
"""
import json
import urllib.request
import urllib.error

with open("meeting.txt", "r", encoding="utf-8") as f:
    meeting_text = f.read()

PROMPT: str = (
    "Extract the action items from the following meeting transcript:\n\n"
    f"{meeting_text}\n\n"
    "Action Items:"
)

payload = {
    "model": "llama3",
    "prompt": PROMPT,
    "stream": False,
}

req = urllib.request.Request(
    "http://localhost:11434/api/generate",
    data=json.dumps(payload).encode("utf-8"),
    headers={"Content-Type": "application/json"},
    method="POST",
)

try:
    with urllib.request.urlopen(req, timeout=30) as resp:
        body = resp.read().decode("utf-8")
        try:
            data = json.loads(body)
        except json.JSONDecodeError:
            print(body)
        else:
            print(data.get("response"))
except urllib.error.URLError as e:
    print(f"Request failed: {e}")

"""
file_handler.py
Extracts plain text from uploaded meeting documents.
Supports PDF (via pdfplumber), DOCX (via python-docx), and TXT.
Returns the raw text string ready to be passed to the AI service.
"""

from pathlib import Path


ALLOWED_EXTENSIONS = {".pdf", ".docx", ".txt"}
MAX_FILE_BYTES = 10 * 1024 * 1024  # 10 MB hard limit


# ---------------------------------------------------------------------------
# Public API
# ---------------------------------------------------------------------------

def extract_text(file_path: str | Path) -> str:
    """
    Extract and return the full plain-text content of an uploaded file.

    Raises:
        ValueError  – unsupported extension or file is empty after extraction.
        RuntimeError – extraction library fails (corrupt file, scanned PDF, etc.)
    """
    path = Path(file_path)
    ext = path.suffix.lower()

    if ext not in ALLOWED_EXTENSIONS:
        raise ValueError(
            f"Unsupported file type '{ext}'. "
            f"Accepted types: {', '.join(ALLOWED_EXTENSIONS)}"
        )

    if path.stat().st_size > MAX_FILE_BYTES:
        raise ValueError("File exceeds the 10 MB size limit.")

    if ext == ".pdf":
        text = _extract_pdf(path)
    elif ext == ".docx":
        text = _extract_docx(path)
    else:
        text = _extract_txt(path)

    text = text.strip()
    if not text:
        raise ValueError(
            "No readable text was found in the uploaded file. "
            "If this is a scanned document, please upload a text-based version."
        )

    return text


# ---------------------------------------------------------------------------
# Format-specific extractors
# ---------------------------------------------------------------------------

def _extract_pdf(path: Path) -> str:
    try:
        import pdfplumber
    except ImportError:
        raise RuntimeError("pdfplumber is not installed. Run: pip install pdfplumber")

    pages = []
    try:
        with pdfplumber.open(path) as pdf:
            for page in pdf.pages:
                page_text = page.extract_text()
                if page_text:
                    pages.append(page_text)
    except Exception as exc:
        raise RuntimeError(f"PDF extraction failed: {exc}") from exc

    return "\n\n".join(pages)


def _extract_docx(path: Path) -> str:
    try:
        from docx import Document
    except ImportError:
        raise RuntimeError("python-docx is not installed. Run: pip install python-docx")

    try:
        doc = Document(str(path))
        paragraphs = [p.text for p in doc.paragraphs if p.text.strip()]
        return "\n".join(paragraphs)
    except Exception as exc:
        raise RuntimeError(f"DOCX extraction failed: {exc}") from exc


def _extract_txt(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8", errors="replace")
    except Exception as exc:
        raise RuntimeError(f"TXT read failed: {exc}") from exc
